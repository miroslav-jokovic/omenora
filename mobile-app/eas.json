{
  "cli": {
    "version": ">=18.0.0",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "node": "22.2.0",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "enterpriseProvisioning": "adhoc"
      }
    },
    "development-simulator": {
      "node": "22.2.0",
      "developmentClient": true,
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "22.2.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "$EXPO_PUBLIC_SENTRY_DSN",
        "SENTRY_AUTH_TOKEN": "$SENTRY_AUTH_TOKEN"
      }
    },
    "production": {
      "node": "22.2.0",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "enterpriseProvisioning": "universal"
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "$EXPO_PUBLIC_SENTRY_DSN",
        "SENTRY_AUTH_TOKEN": "$SENTRY_AUTH_TOKEN"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "TODO: founder to fill — local file path to Google Play service-account JSON",
        "track": "production"
      },
      "ios": {
        "ascAppId": "6768273672",
        "ascApiKeyPath": "TODO: founder to fill — local file path to .p8 App Store Connect API key",
        "ascApiKeyIssuerId": "1ef6da1b-f4f2-49d7-b99e-00fff110c7ed",
        "ascApiKeyId": "2WH7BK98S8"
      }
    }
  }
}
